{
  "name": "burokku",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm typecheck && pnpm --filter './example/*' build && cargo build --workspace",
    "dev": "cargo run -p burokku-example-counter",
    "example:counter": "cargo run -p burokku-example-counter",
    "example:layouts": "cargo run -p burokku-example-layouts",
    "typecheck": "pnpm --filter @burokku/runtime build && pnpm --filter './example/*' typecheck",
    "test": "pnpm typecheck && pnpm --filter './example/*' build && cargo test --workspace",
    "clean": "cargo clean && rm -rf example/counter/dist example/layouts/dist"
  }
}
