{
  "name": "burokku",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "cargo build --workspace && pnpm --filter './example/*' build",
    "dev": "pnpm --filter @burokku/example-counter dev",
    "example:counter": "pnpm --filter @burokku/example-counter dev",
    "example:layouts": "pnpm --filter @burokku/example-layouts dev",
    "typecheck": "pnpm --filter './example/*' typecheck",
    "test": "cargo test --workspace && pnpm typecheck",
    "clean": "cargo clean && rm -rf example/counter/dist example/layouts/dist"
  }
}
